	dar_pokemon 447 5
	bandera pkchoose = 2
	bandera pkstarter = 447
	bandera fy_002 = 1
	narrar 6837 Riolu
	exclamacion obj_Oak1_s6
	hablante 404
	decir 6838 Riolu
	decir 6839
	narrar 6840
	dar_objeto 1 15
	asignar_ball 1
	decir 6841 B F12
sino:
	ocultar_pokemon
