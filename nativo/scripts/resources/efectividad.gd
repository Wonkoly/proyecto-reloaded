static func multiplicador(atacante: Tipos.Tipo, defensores: Array[Tipos.Tipo]) -> float:
	var eff: float = 1.0
	for tipo: Tipos.Tipo in defensores:
		eff *= TABLA[atacante][tipo]
	return eff
