; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Proyecto Reloaded (nativo)"
run/main_scene="res://scenes/debug/menu_pruebas.tscn"
config/features=PackedStringArray("4.7")

[autoload]

GameState="*res://autoload/game_state.gd"
SaveManager="*res://autoload/save_manager.gd"
AudioManager="*res://autoload/audio_manager.gd"
SceneManager="*res://autoload/scene_manager.gd"
DevConsole="*res://autoload/dev_console.gd"

[debug]

gdscript/warnings/untyped_declaration=1

[display]

window/size/viewport_width=576
window/size/viewport_height=324
window/size/window_width_override=1152
window/size/window_height_override=648
window/stretch/mode="viewport"

